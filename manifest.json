{
    "manifest_version": 3,
    "name": "Contextify",
    "description": "Summarize webpage content and ask questions based on context.",
    "version": "1.10",
    "permissions": ["contextMenus", "activeTab"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["styles/chatbox.css"]
      }
    ],

    
    "web_accessible_resources": [
      {
        "resources": ["pdfjs/pdf.worker.js"],
        "matches": ["<all_urls>"]
      }
    ],


    "icons": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "action": {
    "default_title": "Contextify_box",
    "default_popup": "",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
      }
    }
  }

